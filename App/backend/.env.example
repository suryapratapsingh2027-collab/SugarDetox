DATABASE_URL="postgresql://sugardetox:Surya@1234@localhost:5432/sugarDetox?schema=public"
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret"
PORT=4000
NODE_ENV=development
# Browsers only (native apps ignore CORS). Comma-separated origins, leave empty to block all browsers.
CORS_ORIGINS=""

# Password-reset emails (https://resend.com). Without RESEND_API_KEY the code is only printed to the console in development.
RESEND_API_KEY=""
MAIL_FROM="Sugar Detox <no-reply@your-domain.com>"

# Shown on the public /privacy, /terms and /delete-account pages
APP_NAME="Sugar Detox"
COMPANY_NAME="Your Company Name"
SUPPORT_EMAIL="support@your-domain.com"
LEGAL_LAST_UPDATED="30 September 2026"
