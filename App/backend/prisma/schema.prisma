generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  goals        Json     @default("[]")
  appState     Json     @default("{}")
  // Incremented on every state write; used to detect multi-device conflicts.
  stateVersion Int      @default(0)
  // Incremented on password reset; invalidates all previously issued JWTs.
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  resets PasswordReset[]

  @@index([createdAt])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
